# Base de datos Serverless SQLite. La integración Turso de Vercel configura
# estos dos valores automáticamente.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# URL pública definitiva, usada en metadatos y enlaces compartidos.
NEXT_PUBLIC_SITE_URL=

# Co-branding corporativo opcional.
ORG_DISPLAY_NAME=
ORG_LOGO_URL=
ORG_BRAND_COLOR=#694bb5
ORG_ACCENT_COLOR=#b94740
ORG_TIMEZONE=Europe/Madrid
ORG_SUPPORT_EMAIL=

# Enlace público al código y al seguimiento de incidencias cuando exista.
NEXT_PUBLIC_PROJECT_REPOSITORY_URL=

# Programa interno por defecto: ruta Professional, 20 semanas.
PROGRAM_ROUTE=professional
PROGRAM_DURATION_DAYS=140

# Identidad estable opcional para desarrollo local y pruebas. Debe contener
# exactamente 64 caracteres hexadecimales y nunca configurarse en producción.
LAKEHOUSE_DEV_SESSION_ID=
