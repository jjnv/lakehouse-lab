{
  "name": "lakehouse-lab",
  "version": "2.0.0",
  "private": true,
  "description": "Ruta práctica e independiente en español para aprender ingeniería de datos y arquitectura lakehouse.",
  "repository": {
    "type": "git",
    "url": "https://github.com/jjnv/lakehouse-lab.git"
  },
  "bugs": {
    "url": "https://github.com/jjnv/lakehouse-lab/issues"
  },
  "keywords": [
    "databricks",
    "lakehouse",
    "data-engineering",
    "learning-platform",
    "nextjs",
    "cloudflare-workers"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "predev": "node scripts/migrate.mjs",
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "node scripts/migrate.mjs && next build",
    "start": "next start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "lint": "eslint . --ignore-pattern .next --ignore-pattern dist",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs"
  },
  "dependencies": {
    "@libsql/client": "0.17.4",
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "pdf-lib": "1.17.1",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module"
}
